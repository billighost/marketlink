NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=marketlink
TEST_DB_NAME=marketlink_test
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_SECURE=true
UPLOAD_DIR=./uploads
JWT_SECRET=marketlink_super_secure_jwt_secret_dev_key_at_least_32_chars_long
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_BASE_URL=http://localhost:5173
RATE_LIMIT_DISABLED=false
TRUST_PROXY=false

# Slow request warning threshold in milliseconds (default 150)
LOG_SLOW_MS=150

# Gemini AI Assistant Configuration
# Get free API keys from https://aistudio.google.com/ > "Get API key"
# Multiple keys are comma-separated for automatic round-robin and rate-limit rotation
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
GEMINI_RPM_PER_KEY=10
GEMINI_TIMEOUT_MS=12000
ASSISTANT_MAX_TOKENS=400
ASSISTANT_ENABLED=true

# Gmail SMTP Configuration
# Create a 16-character App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM="MarketLink <your_email@gmail.com>"
GMAIL_DAILY_LIMIT=450

